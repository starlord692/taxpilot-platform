APP_NAME="TaxPilot AI"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=false

API_V1_PREFIX=/api/v1

# Local development defaults. Production must provide secure credentials.
DATABASE_URL=postgresql+asyncpg://taxpilot:taxpilot@localhost:5432/taxpilot
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0

# Required for token APIs. Use a unique 32+ character secret in production.
IDENTITY_TOKEN_SECRET_KEY=replace-with-a-secure-random-secret
IDENTITY_ACCESS_TOKEN_EXPIRE_MINUTES=15
IDENTITY_REFRESH_TOKEN_EXPIRE_DAYS=30

DOCUMENT_STORAGE_PATH=storage/documents
DOCUMENT_MAX_UPLOAD_SIZE_BYTES=10485760

OCR_PROVIDER=tesseract
OCR_LANGUAGES=eng
TESSERACT_PATH=
MAX_OCR_PAGES=10
OCR_TIMEOUT=60

LOG_LEVEL=INFO
